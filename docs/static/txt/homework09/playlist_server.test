#!/usr/bin/env python3

import hashlib
import math
import os
import random
import requests
import subprocess
import time
import unittest

# Functions

def sha1sum(s: str) -> str:
    return hashlib.sha1(s.encode()).hexdigest()

def find_open_port(start: int=9000, end: int=9999) -> int:
    with os.popen("ss -tlpn | awk '{print $4}' | cut -d : -f 2") as stream:
        used_ports = {int(port) for port in stream if port.strip().isnumeric()}
        while (port := random.randint(start, end)) in used_ports: pass
        return port

# Unit Tests

class PlaylistTest(unittest.TestCase):
    ''' Playlist Unit Tests '''

    @classmethod
    def setUpClass(cls):
        cls.Points  = 0
        cls.Total   = len([method for method in dir(cls) if method.startswith('test_')])
        cls.host    = '127.0.0.1'
        cls.port    = str(find_open_port())
        cls.logfile = open('playlist_server.log', 'w')
        cls.process = subprocess.Popen(
            ['python3', 'playlist_server.py', cls.host, cls.port],
            stdout  = cls.logfile,
            stderr  = cls.logfile,
        )

        time.sleep(0.25)

    @classmethod
    def tearDownClass(cls):
        cls.process.terminate()
        cls.process.wait()
        cls.logfile.close()

        print()
        print(f'   Score {cls.Points:5.2f} / {cls.Total:5.2f}')
        print(f'   Grade {cls.Points/cls.Total:5.2f} / {1.0:5.2f}')
        print(f'  Status {"Success" if math.isclose(cls.Points, cls.Total) else "Failure"}')

    def test_00_index(self):
        # Success
        response = requests.get(f'http://{self.host}:{self.port}/')
        self.assertEqual(response.status_code, 200)
        self.assertEqual(sha1sum(response.text), '8bb502e8bac986dd780a53559f4450d231dd5dda')
        PlaylistTest.Points += 0.5

        # Failure: Bad Method
        response = requests.post(f'http://{self.host}:{self.port}/')
        self.assertEqual(response.status_code, 405)
        PlaylistTest.Points += 0.5

    def test_01_create_playlist(self):
        # Success: JSON Data
        response = requests.post(f'http://{self.host}:{self.port}/playlist', json={'name': 'Mix Tape 1'})
        self.assertEqual(response.status_code, 200)
        self.assertEqual(response.json(), {'id': 1})
        PlaylistTest.Points += 0.4

        # Success: Form Data
        response = requests.post(f'http://{self.host}:{self.port}/playlist', data={'name': 'Mix Tape 2'})
        self.assertEqual(response.status_code, 200)
        self.assertEqual(response.json(), {'id': 2})
        PlaylistTest.Points += 0.3
        
        # Failure: No name
        response = requests.post(f'http://{self.host}:{self.port}/playlist')
        self.assertEqual(response.status_code, 400)
        PlaylistTest.Points += 0.3

    def test_02_remove_playlist(self):
        # Success
        response = requests.post(f'http://{self.host}:{self.port}/playlist', json={'name': 'Mix Tape 3'})
        self.assertEqual(response.status_code, 200)
        playlist = response.json()['id']
        response = requests.delete(f'http://{self.host}:{self.port}/playlist/{playlist}')
        self.assertEqual(response.status_code, 200)
        PlaylistTest.Points += 0.5

        # Failure: Invalid Playlist ID
        playlist = 999999999999
        response = requests.delete(f'http://{self.host}:{self.port}/playlist/{playlist}')
        self.assertEqual(response.status_code, 404)
        PlaylistTest.Points += 0.5

    def test_03_get_playlist(self):
        # Success
        response = requests.post(f'http://{self.host}:{self.port}/playlist', json={'name': 'Mix Tape 4'})
        self.assertEqual(response.status_code, 200)

        playlist = response.json()['id']
        response = requests.get(f'http://{self.host}:{self.port}/playlist/{playlist}')
        self.assertEqual(response.status_code, 200)
        self.assertEqual(response.json(),
            {'id': playlist, 'name': 'Mix Tape 4', 'items': {'total': 0, 'items': []}}
        )
        PlaylistTest.Points += 0.5

        # Failure: Invalid Playlist ID
        playlist = 999999999999
        response = requests.get(f'http://{self.host}:{self.port}/playlist/{playlist}')
        self.assertEqual(response.status_code, 404)
        PlaylistTest.Points += 0.5

    def test_04_get_playlist_items(self):
        # Success
        response = requests.post(f'http://{self.host}:{self.port}/playlist', json={'name': 'Mix Tape 5'})
        self.assertEqual(response.status_code, 200)

        playlist = response.json()['id']
        response = requests.get(f'http://{self.host}:{self.port}/playlist/{playlist}/items')
        self.assertEqual(response.status_code, 200)
        self.assertEqual(response.json(),
            {'total': 0, 'items': []}
        )
        PlaylistTest.Points += 0.5

        # Failure: Invalid Playlist ID
        playlist = 999999999999
        response = requests.get(f'http://{self.host}:{self.port}/playlist/{playlist}/items')
        self.assertEqual(response.status_code, 404)
        PlaylistTest.Points += 0.5

    def test_05_add_playlist_items(self):
        # Success
        response = requests.post(f'http://{self.host}:{self.port}/playlist', json={'name': 'Mix Tape 6'})
        self.assertEqual(response.status_code, 200)

        playlist = response.json()['id']

        items1   = [{'title': 'DOWN GOES NUMBER ONE', 'url': 'https://youtu.be/2qfxJ3WRy9I'}]
        response = requests.post(f'http://{self.host}:{self.port}/playlist/{playlist}/items', json={
            'items': items1
        })
        self.assertEqual(response.status_code, 200)
        self.assertEqual(response.json(),
            {'total': 1}
        )
        PlaylistTest.Points += 0.25

        items23  = [
            {'title': 'No. 1 Miami vs. No. 11 Notre Dame', 'url': 'https://youtu.be/TBVPzx6iB14'},
            {'title': 'Postgame Press Conference (11.8.26)', 'url': 'https://youtu.be/t73UxjCJ6Pc'},
        ]
        response = requests.post(f'http://{self.host}:{self.port}/playlist/{playlist}/items', json={
            'items': items23, 'position': 1,
        })
        self.assertEqual(response.status_code, 200)
        self.assertEqual(response.json(),
            {'total': 3}
        )
        PlaylistTest.Points += 0.25

        response = requests.get(f'http://{self.host}:{self.port}/playlist/{playlist}/items')
        self.assertEqual(response.status_code, 200)
        self.assertEqual(response.json(),
            {'total': 3, 'items': items1 + items23}
        )
        PlaylistTest.Points += 0.25

        # Failure: Invalid Playlist ID
        playlist = 999999999999
        response = requests.get(f'http://{self.host}:{self.port}/playlist/{playlist}/items')
        self.assertEqual(response.status_code, 404)
        PlaylistTest.Points += 0.25

    def test_06_remove_playlist_items(self):
        # Success
        response = requests.post(f'http://{self.host}:{self.port}/playlist', json={'name': 'Mix Tape 7'})
        self.assertEqual(response.status_code, 200)

        playlist = response.json()['id']
        items1   = [{'title': 'DOWN GOES NUMBER ONE', 'url': 'https://youtu.be/2qfxJ3WRy9I'}]
        items23  = [
            {'title': 'No. 1 Miami vs. No. 11 Notre Dame', 'url': 'https://youtu.be/TBVPzx6iB14'},
            {'title': 'Postgame Press Conference (11.8.26)', 'url': 'https://youtu.be/t73UxjCJ6Pc'},
        ]
        response = requests.post(f'http://{self.host}:{self.port}/playlist/{playlist}/items', json={
            'items': items1 + items23
        })
        self.assertEqual(response.status_code, 200)
        self.assertEqual(response.json(),
            {'total': 3}
        )

        total = 3
        for items in (items1, items23):
            response = requests.delete(f'http://{self.host}:{self.port}/playlist/{playlist}/items', json={
                'items': [{'url': item['url']} for item in items]
            })
            total   -= len(items)
            self.assertEqual(response.status_code, 200)
            self.assertEqual(response.json(),
                {'total': total}
            )
            PlaylistTest.Points += 0.40

        # Failure: Invalid Playlist ID
        playlist = 999999999999
        response = requests.delete(f'http://{self.host}:{self.port}/playlist/{playlist}/items', json={
            'items': items
        })
        self.assertEqual(response.status_code, 404)
        PlaylistTest.Points += 0.20

# Main Execution

if __name__ == '__main__':
    unittest.main()

